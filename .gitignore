# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files hold API keys: never commit them. Only the documented template is tracked.
.env
.env.*
!.env.example

# Diagnostic-only route geometry from scripts/build-routes.mjs (never app data).
# docs/routes/diagnostic-viewer.html stays tracked.
docs/routes/diagnostics/*.geojson

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.playwright-mcp/
