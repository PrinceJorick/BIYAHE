# All optional. With nothing set, the app runs on demo data (IndexedDB + cross-tab sync) and fetches walking
# routes from the public OpenStreetMap foot router. Copy this file to .env.local and fill in what you need.

# Live data: create a Supabase project, run supabase/schema.sql, then supabase/migrations/*.sql in order.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Walking routes to safe spots: an OSRM-compatible base URL (without /route). Leave this line commented out to
# use https://routing.openstreetmap.de/routed-foot ; set it to an empty value to turn live walking routes off
# (the app then shows saved routes or straight-line estimates).
# VITE_WALK_ROUTER_URL=
