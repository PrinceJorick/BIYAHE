# BIYAHE environment. Copy this file to `.env` (already git-ignored) and fill in the keys you have.
# Every value is optional: with nothing set the app runs on demo data, a simple offline map, estimated traffic
# and no news feed. Restart `npm run dev` after changing this file.
#
# VITE_* values are compiled into the browser bundle, so they are public. Protect them with restrictions in the
# provider's console (HTTP referrer + API restrictions). Values WITHOUT the VITE_ prefix stay on the server
# (Vercel function /api/news and the dev server) and never reach the browser.

# ── Google Maps Platform ────────────────────────────────────────────────────────────────────────────────────
# One browser key for the map, live traffic and road-following routes.
#   1. console.cloud.google.com → APIs & Services → enable "Maps JavaScript API" and "Routes API".
#   2. Credentials → Create API key → Application restrictions: Websites, add
#        http://localhost:5173/*  http://localhost:4173/*  https://<your-vercel-domain>/*
#      API restrictions: Maps JavaScript API, Routes API.
VITE_GOOGLE_MAPS_API_KEY=
# Optional vector map style. Leave empty to use the built-in muted raster style.
# (Google Cloud → Google Maps Platform → Map management → Create Map ID, type JavaScript.)
VITE_GOOGLE_MAPS_MAP_ID=
# Optional separate key for the Routes API (traffic + road-following routes). Leave empty to reuse the Maps key.
# Called from the browser, so restrict it the same way: Websites + API restriction "Routes API" only.
VITE_GOOGLE_ROUTES_API_KEY=

# ── News (server-side only) ─────────────────────────────────────────────────────────────────────────────────
# Optional. Currents News API key (https://currentsapi.services) for /api/news, sent as a Bearer token from the
# server only. Free plan: 250 requests/day; one refresh uses 2 and is cached for 30 minutes.
CURRENTS_API_KEY=

# ── Google Weather API ──────────────────────────────────────────────────────────────────────────────────────
# Current conditions, hourly forecast and PAGASA public alerts. Billable Google Maps Platform service: enable
# "Weather API" and set a quota + budget alert. Two ways to supply it (the browser key wins when both are set):
#   VITE_GOOGLE_WEATHER_API_KEY  browser key, called from the page. Restrict it like the Maps key: Websites
#                                (http://localhost:5173/*, http://localhost:4173/*, https://<your-vercel-domain>/*)
#                                and API restriction "Weather API". Unset: VITE_GOOGLE_MAPS_API_KEY is tried (add
#                                "Weather API" to that key's API restrictions), else the server key below.
#   GOOGLE_WEATHER_API_KEY       server-only key for /api/weather. API restriction "Weather API"; application
#                                restriction NONE (server requests send no Referer, so a website restriction gives 403).
VITE_GOOGLE_WEATHER_API_KEY=
GOOGLE_WEATHER_API_KEY=

# ── Gemini (server-side only) ───────────────────────────────────────────────────────────────────────────────
# Optional plain-language explanation of BIYAHE's own recommendation (/api/explain). Key: aistudio.google.com/apikey.
# GEMINI_MODEL defaults to gemini-2.5-flash when empty.
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Live shared data (Supabase) ─────────────────────────────────────────────────────────────────────────────
# Create a project, run supabase/schema.sql, then supabase/migrations/*.sql in name order.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Walking routes to safe spots ────────────────────────────────────────────────────────────────────────────
# OSRM-compatible base URL (without /route). Leave commented out to use https://routing.openstreetmap.de/routed-foot;
# set it to an empty value to turn live walking routes off (the app then shows saved routes or straight-line
# estimates).
# VITE_WALK_ROUTER_URL=
