{
  "name": "biyahe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "vitest run src/lib/reviewedGeometry.test.ts src/campuses/roads.test.ts src/lib/isolation.test.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "routes:alangilan": "vitest run src/lib/geo.test.ts src/lib/routeChecks.test.ts src/lib/routeVersions.test.ts src/lib/buildRoutes.test.ts && node scripts/build-routes.mjs",
    "routes:preview": "node scripts/build-preview-roads.mjs",
    "routes:approve": "vitest run src/lib/routeChecks.test.ts src/lib/routeVersions.test.ts src/lib/approveRoutes.test.ts && node scripts/approve-routes.mjs",
    "routes:campuses": "node scripts/build-campus-roads.mjs",
    "icons": "node scripts/build-icons.mjs",
    "docs:pdf": "python3 scripts/build-docs-pdf.py"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
